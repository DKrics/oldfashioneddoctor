---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Feedback from '../../components/Feedback.astro';
import Comments from '../../components/Comments.astro';
import { allPosts, readingMinutes, relatedPosts } from '../../lib/posts';
import { formatDate, withBase, categoryHref, tagSlug, blogPostingJsonLd, SITE, absoluteUrl } from '../../lib/site';
import type { Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post, posts },
  }));
}

interface Props {
  post: Post;
  posts: Post[];
}
const { post, posts } = Astro.props;
const { Content } = await render(post);
const hero = withBase(post.data.hero);
const mins = readingMinutes(post.body || '');
const related = relatedPosts(post, posts, 3);
const canonicalPath = Astro.url.pathname;
const jsonLd = blogPostingJsonLd({
  title: post.data.title,
  description: post.data.description,
  url: new URL(canonicalPath, Astro.site).toString(),
  image: new URL(hero, Astro.site).toString(),
  published: post.data.published,
  updated: post.data.updated,
});
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={hero}
  type="article"
  jsonLd={jsonLd}
  published={post.data.published}
  updated={post.data.updated}
>
  <article data-pagefind-body>
    <header class="post-hero">
      <div class="cats">
        {post.data.categories.map((c) => (
          <a class="pill" href={categoryHref(c)} data-pagefind-filter="category">{c}</a>
        ))}
      </div>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p class="byline">
        {formatDate(post.data.published)} · {SITE.author} · {mins} min read
      </p>
    </header>
    <div class="post-cover">
      <img src={hero} alt="" data-pagefind-meta="image" />
    </div>
    <div class="prose">
      <Content />
    </div>
    {post.data.tags.length > 0 && (
      <p class="post-tags" data-pagefind-ignore>
        {post.data.tags.map((t) => (
          <a class="tag" href={withBase(`tags/${tagSlug(t)}/`)}>{t}</a>
        ))}
      </p>
    )}
  </article>
  <Comments
    pageId={post.data.slug}
    pageUrl={absoluteUrl(`posts/${post.data.slug}/`)}
    pageTitle={post.data.title}
  />
  <Feedback />
  {related.length > 0 && (
    <aside class="related wrap" data-pagefind-ignore>
      <h2>Related essays</h2>
      <div class="triptych">
        {related.map((r) => (
          <PostCard post={r} />
        ))}
      </div>
    </aside>
  )}
</BaseLayout>
