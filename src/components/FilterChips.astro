---
import { CATEGORIES, CATEGORY_META, withBase, type Category } from '../lib/site';

interface Props {
  active?: 'all' | Category;
}
const { active = 'all' } = Astro.props;
---
<nav class="chips" aria-label="Filter by category">
  <a class:list={['chip', active === 'all' && 'is-active']} href={withBase()}>All</a>
  {CATEGORIES.map((c) => (
    <a
      class:list={['chip', active === c && 'is-active']}
      href={withBase(`${CATEGORY_META[c].slug}/`)}
    >
      {c}
    </a>
  ))}
</nav>
