---
import { CUSDIS, SITE } from '../lib/site';

interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
}

const { pageId, pageUrl, pageTitle } = Astro.props;
const ready = Boolean(CUSDIS.appId);
---
<section class="comments" id="comments" data-pagefind-ignore>
  <p class="kicker">The waiting room</p>
  <h2>Comments</h2>
  <p class="comments-lede">
    Name, email, and a note. Email is required and is never published.
    Nothing appears here until {SITE.author} approves it.
  </p>

  {ready ? (
    <>
      <p class="comments-msg" data-comments-msg hidden></p>
      <ol class="comment-thread" data-comments-list></ol>
      <p class="comments-empty" data-comments-empty>No approved comments yet.</p>
    </>
  ) : (
    <div class="comments-setup">
      <p>
        The box below is ready. It will start taking notes as soon as the journal’s
        moderation inbox is connected. Until then, write to
        <a href={SITE.twitter} rel="me noopener">{SITE.twitterHandle}</a> on X.
      </p>
    </div>
  )}

  <form class="comment-form" data-comments-form novalidate>
    <div class="comment-row">
      <label for="comment-name">Name <span aria-hidden="true">*</span></label>
      <input id="comment-name" name="nickname" type="text" required maxlength="80" autocomplete="name" disabled={!ready} />
    </div>
    <div class="comment-row">
      <label for="comment-email">Email <span aria-hidden="true">*</span></label>
      <input id="comment-email" name="email" type="email" required maxlength="200" autocomplete="email" disabled={!ready} />
      <small>Used only for moderation and optional reply notice. Never shown on the page.</small>
    </div>
    <div class="comment-row">
      <label for="comment-body">Comment <span aria-hidden="true">*</span></label>
      <textarea id="comment-body" name="content" required maxlength="4000" rows="6" disabled={!ready}></textarea>
    </div>
    <label class="comment-check">
      <input type="checkbox" name="acceptNotify" disabled={!ready} />
      Email me if there is a reply (you will get a confirmation link first)
    </label>
    <input type="hidden" name="parentId" value="" />
    <p class="comment-replying" data-comments-replying hidden>
      Replying to a comment.
      <button type="button" data-comments-cancel-reply>Cancel reply</button>
    </p>
    <button class="btn btn-ink" type="submit" disabled={!ready}>Send for review</button>
  </form>

  {ready && (
    <div
      hidden
      data-comments-config
      data-host={CUSDIS.host}
      data-app-id={CUSDIS.appId}
      data-page-id={pageId}
      data-page-url={pageUrl}
      data-page-title={pageTitle}
    ></div>
  )}
</section>
{ready && <script src="../scripts/comments.ts"></script>}
