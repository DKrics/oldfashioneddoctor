---
import { COMMENTS, SITE } from '../lib/site';

interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
}

const { pageId, pageUrl, pageTitle } = Astro.props;
const ready = Boolean(COMMENTS.accessKey);
---
<section class="comments" id="comments" data-pagefind-ignore>
  <p class="kicker">The waiting room</p>
  <h2>Comments</h2>
  <p class="comments-lede">
    Name, email, and a note. Email is required and is never published.
    Notes go to the journal for review. They do not appear on this page.
  </p>

  {ready ? (
    <p class="comments-msg" data-comments-msg hidden></p>
  ) : (
    <div class="comments-setup">
      <p>
        The box below is ready. It will start taking notes as soon as the journal’s
        moderation inbox is connected. Until then, write to
        <a href={SITE.twitter} rel="me noopener">{SITE.twitterHandle}</a> on X.
      </p>
    </div>
  )}

  <form class="comment-form" data-comments-form novalidate>
    {ready && <input type="hidden" name="access_key" value={COMMENTS.accessKey} />}
    <input type="hidden" name="pageTitle" value={pageTitle} />
    <input type="hidden" name="pageUrl" value={pageUrl} />
    <input type="hidden" name="pageId" value={pageId} />
    <input type="hidden" name="subject" value={`Comment: ${pageTitle}`} />
    <div class="comment-hp" aria-hidden="true">
      <label for="comment-website">Website</label>
      <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
    </div>
    <div class="comment-row">
      <label for="comment-name">Name <span aria-hidden="true">*</span></label>
      <input id="comment-name" name="name" type="text" required maxlength="80" autocomplete="name" disabled={!ready} />
    </div>
    <div class="comment-row">
      <label for="comment-email">Email <span aria-hidden="true">*</span></label>
      <input id="comment-email" name="email" type="email" required maxlength="200" autocomplete="email" disabled={!ready} />
      <small>Used only for moderation. Never shown on the page.</small>
    </div>
    <div class="comment-row">
      <label for="comment-body">Comment <span aria-hidden="true">*</span></label>
      <textarea id="comment-body" name="message" required maxlength="4000" rows="6" disabled={!ready}></textarea>
    </div>
    <button class="btn btn-ink" type="submit" disabled={!ready}>Send for review</button>
  </form>
</section>
{ready && <script src="../scripts/comments.ts"></script>}
